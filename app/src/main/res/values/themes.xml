<resources>
    <style name="Base.Theme.Wordle" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="Theme.Wordle" parent="Base.Theme.Wordle" />

    <!-- Fixed Wordle Grid Cell style -->
    <style name="WordleGridCell">
        <item name="android:background">@drawable/cell_border</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="WordleButtonStyle" parent="Widget.Material3.Button">
        <item name="android:textColor">#000000</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:padding">0dp</item>
        <item name="shapeAppearance">@null</item>

        <item name="android:background">@drawable/rounded_button</item>
        <item name="backgroundTint">@null</item>

    </style>



</resources>
